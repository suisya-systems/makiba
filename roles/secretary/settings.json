{
  "permissions": {
    "deny": [
      "Bash(hc:*)",
      "Bash(herdr-core:*)",
      "Bash(herdr-app:*)",
      "Read(~/.config/herdr-core/**)",
      "Edit(~/.config/herdr-core/**)",
      "Read(~/.config/herdr-app/**)",
      "Edit(~/.config/herdr-app/**)",
      "Read(~/.local/state/herdr-core/**)",
      "Edit(~/.local/state/herdr-core/**)",
      "Read(~/.config/makiba/base/**)",
      "Edit(~/.config/makiba/base/**)",
      "Read(~/.config/makiba/person.key)",
      "Edit(~/.config/makiba/person.key)",
      "Read(~/.config/makiba/gate.key)",
      "Edit(~/.config/makiba/gate.key)",
      "Bash(git commit *--no-veri*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Edit(~/.local/share/makiba/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(.claude/settings*.json)",
      "Edit(.mcp.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-base"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-dangerous-git"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-no-verify"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-workers-delete"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook merge-gate",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-foreground-subagent"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["api.github.com"]
    },
    "filesystem": {
      "denyRead": [
        "~/.config/herdr-core",
        "~/.config/herdr-app",
        "~/.local/state/herdr-core",
        "~/.config/makiba/base",
        "~/.config/makiba/person.key",
        "~/.config/makiba/gate.key"
      ],
      "denyWrite": [
        "~/.config/herdr-core",
        "~/.config/herdr-app",
        "~/.local/state/herdr-core",
        "~/.config/makiba/base",
        "~/.config/makiba/person.key",
        "~/.config/makiba/gate.key",
        "~/.local/share/makiba"
      ]
    }
  }
}

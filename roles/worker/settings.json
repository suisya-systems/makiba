{
  "permissions": {
    "deny": [
      "Bash(hc:*)",
      "Bash(herdr-core:*)",
      "Bash(herdr-app:*)",
      "Read(~/.config/herdr-core/**)",
      "Edit(~/.config/herdr-core/**)",
      "Read(~/.config/herdr-app/**)",
      "Edit(~/.config/herdr-app/**)",
      "Read(~/.local/state/herdr-core/**)",
      "Edit(~/.local/state/herdr-core/**)",
      "Read(~/.config/makiba/base/**)",
      "Edit(~/.config/makiba/base/**)",
      "Read(~/.config/makiba/person.key)",
      "Edit(~/.config/makiba/person.key)",
      "Edit(~/.local/share/makiba/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(.claude/settings*.json)",
      "Edit(.mcp.json)",
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(gh api:*)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-base"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-push"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-dangerous-git"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-no-verify-code-run"
          },
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-workers-delete"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook worker-boundary"
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${MAKIBA_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/makiba}/makiba\" hook deny-foreground-subagent"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.config/herdr-core",
        "~/.config/herdr-app",
        "~/.local/state/herdr-core",
        "~/.config/makiba/base",
        "~/.config/makiba/person.key",
        "~/.config/gh/hosts.yml"
      ],
      "denyWrite": [
        "~/.config/herdr-core",
        "~/.config/herdr-app",
        "~/.local/state/herdr-core",
        "~/.config/makiba/base",
        "~/.config/makiba/person.key",
        "~/.local/share/makiba"
      ]
    }
  }
}
